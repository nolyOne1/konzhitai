FROM golang:1.27.0-alpine3.24 AS builder

ARG GOPROXY=https://mirrors.cloud.tencent.com/go,direct
ARG GOSUMDB=sum.golang.google.cn
ENV GOPROXY=${GOPROXY} GOSUMDB=${GOSUMDB}

WORKDIR /src
RUN apk add --no-cache ca-certificates git
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/yunling-ops ./cmd/ops

FROM restic/restic:0.19.1 AS restic

FROM quay.io/minio/mc:RELEASE.2025-08-13T08-35-41Z AS minio-client

FROM postgres:18.6-alpine

RUN apk add --no-cache ca-certificates tzdata && \
    addgroup -S -g 10001 yunling && \
    adduser -S -D -H -u 10001 -G yunling yunling && \
    ln -s /usr/local/bin/pg_dump /usr/bin/pg_dump && \
    ln -s /usr/local/bin/pg_restore /usr/bin/pg_restore && \
    ln -s /usr/local/bin/psql /usr/bin/psql
COPY --from=restic /usr/bin/restic /usr/bin/restic
COPY --from=minio-client /usr/bin/mc /usr/bin/mc
COPY --from=builder /out/yunling-ops /usr/local/bin/yunling-ops
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/yunling-ops"]
