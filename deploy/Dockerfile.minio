FROM golang:1.24.8-alpine3.22@sha256:3d78beb141d98f42337f1252ecf2a5f20374109929a4c3f6817f9e4179cc0ae5 AS builder

ARG MINIO_VERSION=RELEASE.2025-10-15T17-29-55Z
ARG GOPROXY=https://mirrors.cloud.tencent.com/go,direct
ARG GOSUMDB=sum.golang.google.cn
RUN apk add --no-cache ca-certificates git
RUN GOBIN=/out CGO_ENABLED=0 GOPROXY="${GOPROXY}" GOSUMDB="${GOSUMDB}" \
    go install -trimpath "github.com/minio/minio@${MINIO_VERSION}"

FROM alpine:3.22@sha256:14358309a308569c32bdc37e2e0e9694be33a9d99e68afb0f5ff33cc1f695dce

ARG MINIO_VERSION=RELEASE.2025-10-15T17-29-55Z
LABEL org.opencontainers.image.title="MinIO" \
      org.opencontainers.image.source="https://github.com/minio/minio" \
      org.opencontainers.image.version="${MINIO_VERSION}"
RUN apk add --no-cache ca-certificates curl tzdata
COPY --from=builder /out/minio /usr/local/bin/minio
EXPOSE 9000
VOLUME ["/data"]
ENTRYPOINT ["/usr/local/bin/minio"]
CMD ["server", "/data"]
