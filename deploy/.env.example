# 复制为 deploy/.env 后填写。不要提交 deploy/.env 或 deploy/secrets/。
YUNLING_DOMAIN=yunling.example.com
YUNLING_TLS_EMAIL=ops@example.com

YUNLING_POSTGRES_DB=yunling
YUNLING_POSTGRES_USER=yunling
YUNLING_POSTGRES_PASSWORD=请替换为至少32位随机密码
YUNLING_REDIS_PASSWORD=请替换为至少32位随机密码
YUNLING_MINIO_ROOT_USER=yunling-storage
YUNLING_MINIO_ROOT_PASSWORD=请替换为至少32位随机密码
YUNLING_S3_BUCKET=yunling-artifacts

YUNLING_MASTER_KEY_VERSION=1
YUNLING_SCHEDULER_SCAN_INTERVAL=15s
YUNLING_OPS_SCAN_INTERVAL=15s

# 仅在执行 docker compose run --rm bootstrap 时使用；完成后立即从 .env 删除。
YUNLING_BOOTSTRAP_EMAIL=admin@example.com
YUNLING_BOOTSTRAP_NAME=系统管理员
YUNLING_BOOTSTRAP_PASSWORD=请替换为至少12位强密码
